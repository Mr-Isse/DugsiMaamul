{
  "name": "mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo run:android",
    "ios": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo run:ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 expo start --web",
    "start:hamar": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ENVFILE=.env.hamar expo start",
    "start:hamar-jajab": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ENVFILE=.env.hamar-jajab expo start",
    "clean": "expo start -c",
    "fix-deps": "npx expo install --check && npm dedupe"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "dotenv": "^16.6.1",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "hoist-non-react-statics": "^3.3.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lucide-react-native": "^0.479.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.76.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.15.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^22.13.10",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "postcss": "^8.5.10"
  }
